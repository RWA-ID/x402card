{
  "name": "x402card",
  // OAuth for MCP clients around the app (src/index.ts).
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: OAuth client metadata documents are fetched from public hosts only.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    // x402card.eth's ETH address before the resolver switch; served by the gateway.
    "PARENT_ADDR": "0x5A578eDdD28Bac066464BB2462ff052a65103602",
    // Base address for DELEGATE cardholders; +<label>-<ts> is appended.
    "CARDHOLDER_EMAIL": "agents@x402card.dev",
    // Returned to agents with escalated funding requests.
    "APPROVAL_URL": "https://x-card.dev/approve#{id}",
    // shop.xcard.eth (the demo merchant) is verified on these too, not only on the gateway's origin.
    "DEMO_MERCHANT_ORIGINS": "https://api.x-card.dev https://mcp.x-card.dev"
  },
  // workers.dev must stay on: it's the CCIP gateway URL on-chain and in existing MCP client configs.
  // With "routes" set and this left out, wrangler turns workers.dev OFF.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "mcp.x-card.dev", "custom_domain": true },
    { "pattern": "api.x-card.dev", "custom_domain": true }
  ],
  // Anomaly check across all cards.
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [
    // Filled in by `wrangler kv namespace create KV`.
    { "binding": "KV", "id": "a12b4e0315d446bfafc6c61a811f0bca" },
    // OAuth clients, grants and tokens (hashed; props encrypted) for MCP clients.
    { "binding": "OAUTH_KV", "id": "ebfa28d0bffd4d2eb6c438aef68b31c6" }
  ]
  // Secrets (wrangler secret put): GATEWAY_SIGNER_KEY, AWX_CLIENT_ID, AWX_API_KEY, MCP_ADMIN_TOKEN, APPROVAL_SECRET,
  // ETH_RPC_URL, TAP_PRIVATE_KEY, RESEND_API_KEY. Optional var OPERATORS: wallets that may connect an MCP client to every card.
}
