{
  "name": "x402card",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // x402card.eth's ETH address before the resolver switch; served by the gateway.
    "PARENT_ADDR": "0x5f11a48230f7CdaB91A2361576239091E4b1165b",
    // Base address for DELEGATE cardholders; +<label>-<ts> is appended.
    "CARDHOLDER_EMAIL": "agents@x402card.dev"
  },
  // Anomaly check across all cards.
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [
    // Filled in by `wrangler kv namespace create KV`.
    { "binding": "KV", "id": "a12b4e0315d446bfafc6c61a811f0bca" }
  ]
  // Secrets (wrangler secret put): GATEWAY_SIGNER_KEY, AWX_CLIENT_ID, AWX_API_KEY, MCP_ADMIN_TOKEN, APPROVAL_SECRET
}
